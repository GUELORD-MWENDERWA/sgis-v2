# Copy this file to .env and fill it in. Never commit .env.
# Generate a key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
DEBUG=True
# Development: sqlite:///db.sqlite3 — production: postgresql://USER:PASSWORD@HOST:5432/NAME
DATABASE_URL=sqlite:///db.sqlite3
